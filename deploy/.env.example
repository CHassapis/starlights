# Copy to .env (setup.sh does this and fills in random values). Never commit .env.

# SQL Server's sa password: at least 8 characters with upper case, lower case and a digit
STARLIGHTS_SA_PASSWORD=
# sent by ./admin.sh for content changes (imports); any long random string
STARLIGHTS_ADMIN_KEY=
# the site's admin password: the key button in the app's header. It opens every locked character and campaign,
# makes you the DM of any campaign, and allows homebrew
STARLIGHTS_MASTER_PASSWORD=
# the port the site is served on (http://<this machine>:8093)
STARLIGHTS_PORT=8093
